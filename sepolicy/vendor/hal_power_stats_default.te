#
# Stock vendor and odm policy, generated by tools/emit.py.
# Review before shipping, the platform side is assumed.
#
type hal_power_stats_default, domain;
init_daemon_domain(hal_power_stats_default)
type hal_power_stats_default_exec, exec_type, file_type, vendor_file_type;
allow hal_power_stats_default hal_power_stats_default_exec:file { read getattr map execute open entrypoint };
allow hal_power_stats_default sysfs:dir { read open };
allow hal_power_stats_default sysfs:file { read open };
