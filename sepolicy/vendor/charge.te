# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type charge, domain;

type charge_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(charge)

allow charge charge_exec:file { read getattr map execute open entrypoint };
allow charge block_device_202604:dir search;
allow charge device_202604:dir { read write open };
allow charge device_202604:chr_file { create unlink };
allow charge vendor_shell_exec_202604:file { read execute open execute_no_trans };
allow charge graphics_device_202604:dir search;
allow charge graphics_device_202604:chr_file { ioctl read write open };
allow charge input_device_202604:dir { read open search };
allow charge input_device_202604:chr_file { ioctl read open };
allow charge charge:capability { sys_admin sys_boot sys_tty_config };
allow charge charge:capability2 block_suspend;
allow charge refnotify_device:chr_file { ioctl read write getattr map execute open entrypoint };
allow charge kmsg_device_202604:chr_file { write open };
allow charge sysfs_202604:file { read write open };
allow charge sysfs_202604:dir { read open };
allow charge sysfs_wake_lock_202604:file { read write open };
allow charge prod_file:dir { read getattr open search };
allow charge mnt_vendor_file_202604:dir { read getattr open search };
allow charge mnt_vendor_file_202604:file { read open };
allow charge prod_file:file { ioctl read write getattr setattr lock unlink open };
allow charge gpu_device_202604:chr_file { ioctl read write map open };
allow charge sysfs_leds_202604:dir { read open search };
allow charge sysfs_leds_202604:file { read write open };
allow charge sysfs_power_202604:dir { read open search };
allow charge sysfs_power_202604:file { read write open };
allow charge sysfs_extdata:dir { read open search };
allow charge sysfs_extdata:file { read write getattr open };
allow charge sysfs_rtc_202604:dir { read open search };
allow charge sysfs_rtc_202604:file { read write open };
allow charge tty_device_202604:chr_file { ioctl read write open };
allow charge vendor_hwrotation_prop:file { read getattr map open };
allow charge proc_cmdline_202604:file { read open };
allow charge vendor_fs_prop:file { read getattr map open };
