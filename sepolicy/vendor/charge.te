type charge, domain;
init_daemon_domain(charge)
type charge_exec, exec_type, file_type, vendor_file_type;
allow charge charge_exec:file { read getattr map execute open entrypoint };
allow charge block_device:dir search;
allow charge device:dir { read write open };
allow charge device:chr_file { create unlink };
allow charge vendor_shell_exec:file { read execute open execute_no_trans };
allow charge graphics_device:dir search;
allow charge graphics_device:chr_file { ioctl read write open };
allow charge input_device:dir { read open search };
allow charge input_device:chr_file { ioctl read open };
allow charge charge:capability { sys_admin sys_boot sys_tty_config };
allow charge charge:capability2 block_suspend;
allow charge refnotify_device:chr_file { ioctl read write getattr map execute open entrypoint };
allow charge kmsg_device:chr_file { write open };
allow charge sysfs:file { read write open };
allow charge sysfs:dir { read open };
allow charge sysfs_wake_lock:file { read write open };
allow charge prod_file:dir { read getattr open search };
allow charge prod_file:file { ioctl read write getattr setattr lock unlink open };
allow charge gpu_device:chr_file { ioctl read write map open };
allow charge sysfs_leds:dir { read open search };
allow charge sysfs_leds:file { read write open };
allow charge sysfs_power:dir { read open search };
allow charge sysfs_power:file { read write open };
allow charge sysfs_extdata:dir { read open search };
allow charge sysfs_extdata:file { read write getattr open };
allow charge sysfs_rtc:dir { read open search };
allow charge sysfs_rtc:file { read write open };
allow charge tty_device:chr_file { ioctl read write open };
allow charge vendor_hwrotation_prop:file { read getattr map open };
