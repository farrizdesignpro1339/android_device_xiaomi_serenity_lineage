type zramwb-sh, domain;
init_daemon_domain(zramwb-sh)
type zramwb-sh_exec, exec_type, file_type, vendor_file_type;
allow zramwb-sh zramwb-sh_exec:file { read getattr map execute open entrypoint };
allow zramwb-sh vendor_toolbox_exec:file execute_no_trans;
allow zramwb-sh vendor_file:file execute_no_trans;
allow zramwb-sh property_socket:sock_file write;
allow zramwb-sh init:unix_stream_socket connectto;
allow zramwb-sh vendor_zramwb_prop:property_service set;
allow zramwb-sh vendor_zramwb_prop:file { read getattr map open };
