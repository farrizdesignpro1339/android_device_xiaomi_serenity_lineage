#
# Stock vendor and odm policy, generated by tools/emit.py.
# Review before shipping, the platform side is assumed.
#
type hal_trustyclientaidl_default, domain;
init_daemon_domain(hal_trustyclientaidl_default)
type hal_trustyclientaidl_default_exec, exec_type, file_type, vendor_file_type;
allow hal_trustyclientaidl_default dumpstate:binder transfer;
allow hal_trustyclientaidl_default hal_trustyclientaidl_default_exec:file { read getattr map execute open entrypoint };
allow hal_trustyclientaidl_default hal_codec2_unisoc:binder transfer;
allow hal_trustyclientaidl_default servicemanager:file { read getattr map open };
allow hal_trustyclientaidl_default servicemanager:binder { call transfer };
allow hal_trustyclientaidl_default hal_trustyclientaidl_service:service_manager { add find };
allow hal_trustyclientaidl_default platform_app:fd use;
allow hal_trustyclientaidl_default teetz_device:chr_file { ioctl read write open };
allow hal_trustyclientaidl_default platform_app:binder transfer;
allow hal_trustyclientaidl_default hal_codec2_unisoc:binder transfer;
allow hal_trustyclientaidl_default mediacodec:binder transfer;
allow hal_trustyclientaidl_default mediacodec:binder transfer;
