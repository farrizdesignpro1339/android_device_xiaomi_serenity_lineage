# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type univndstabserver, domain;
typeattribute univndstabserver mlstrustedsubject;

type univndstabserver_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(univndstabserver)

allow univndstabserver univndstabserver_exec:file { read getattr map execute open entrypoint };
allow univndstabserver servicemanager_202604:binder { call transfer };
allow univndstabserver unistab_vndservice:service_manager add;
allow univndstabserver univndstabserver:capability { sys_admin sys_nice };
allow univndstabserver proc_monitorenable_202604:file { read write getattr setattr open };
allow univndstabserver system_server_202604:binder { call transfer };
allow univndstabserver blackbox_file:dir { ioctl read write create getattr setattr open add_name remove_name search rmdir };
allow univndstabserver blackbox_file:file { read write create getattr setattr append unlink rename open };
allow univndstabserver kernel_202604:process { getsched setsched };
allow univndstabserver platform_app_202604:process { getsched setsched };
allow univndstabserver priv_app_202604:process { getsched setsched };
allow univndstabserver system_app_202604:process { getsched setsched };
allow univndstabserver untrusted_app_all:process { getsched setsched };
allow univndstabserver system_server_202604:process { getsched setsched };
allow univndstabserver priv_app:process { getsched setsched };
allow univndstabserver gmscore_app_202604:process { getsched setsched };
allow univndstabserver sysfs_202604:dir { read open search };
allow univndstabserver sysfs_202604:file { read write getattr open watch watch_reads };
allow univndstabserver sysfs_gpu_boost:file { write open };
allow univndstabserver cgroup_202604:file { read write getattr open };
allow univndstabserver sysfs_devices_system_cpu_202604:file { write open };
allow univndstabserver platform_app_202604:process sigkill;
allow univndstabserver priv_app_202604:process sigkill;
allow univndstabserver system_app_202604:process sigkill;
allow univndstabserver untrusted_app_all:process sigkill;
allow univndstabserver proc_202604:dir search;
allow univndstabserver proc_202604:file { read write getattr open watch watch_reads };
