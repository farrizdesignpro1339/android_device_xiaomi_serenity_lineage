# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type unisoc_hal_usb, domain;
hal_server_domain(unisoc_hal_usb, hal_usb)

type unisoc_hal_usb_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(unisoc_hal_usb)

allow unisoc_hal_usb unisoc_hal_usb_exec:file { read getattr map execute open entrypoint };
allow unisoc_hal_usb configfs_202604:dir { read write add_name search };
allow unisoc_hal_usb configfs_202604:file { read write getattr open };
allow unisoc_hal_usb sysfs_power_202604:dir { read search };
allow unisoc_hal_usb sysfs_power_202604:file { read write getattr open };
allow unisoc_hal_usb sysfs_202604:dir { read open search };
allow unisoc_hal_usb sysfs_202604:file { read write getattr open };
allow unisoc_hal_usb sysfs_udc_202604:dir { read open search };
allow unisoc_hal_usb sysfs_udc_202604:file { read write getattr open };
allow unisoc_hal_usb functionfs_202604:dir { read write watch watch_reads add_name search };
allow unisoc_hal_usb functionfs_202604:file { read write getattr open };
allow unisoc_hal_usb property_socket_202604:sock_file write;
allow unisoc_hal_usb init_202604:unix_stream_socket connectto;
allow unisoc_hal_usb vendor_engpc_prop:property_service set;
allow unisoc_hal_usb vendor_engpc_prop:file { read getattr map open };
allow unisoc_hal_usb usb_control_prop_202604:file { read getattr map open };
allow unisoc_hal_usb vendor_sys_prop:file { read getattr map open };
