type sardiag, domain;
init_daemon_domain(sardiag)
type sardiag_exec, exec_type, file_type, vendor_file_type;
allow sardiag sardiag_exec:file { read getattr map execute open entrypoint };
allow sardiag sardiag_exec:file { read getattr map execute open execute_no_trans entrypoint };
allow sardiag sysfs_sensor:file { read write open };
allow sardiag sysfs:file { read write open };
allow sardiag property_socket:sock_file write;
allow sardiag init:unix_stream_socket connectto;
allow sardiag vendor_file:file { read getattr open };
allow sardiag vendor_sar_calibrate_prop:file { read getattr map open };
allow sardiag vendor_sar_calibrate_prop:property_service set;
