# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_connmgraidl_default, domain;

type hal_connmgraidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_connmgraidl_default)

allow hal_connmgraidl_default hal_connmgraidl_default_exec:file { read getattr map execute open entrypoint };
allow hal_connmgraidl_default app_data_file_202604:file { read write getattr };
allow hal_connmgraidl_default wcnd:unix_stream_socket { read write getattr sendto connectto };
allow hal_connmgraidl_default servicemanager_202604:binder { call transfer };
allow hal_connmgraidl_default hal_connmgraidl_service:service_manager { add find };
allow hal_connmgraidl_default system_app_202604:binder transfer;
