# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_fingerprintmmiaidl_default, domain;
hal_server_domain(hal_fingerprintmmiaidl_default, hal_fingerprint)

type hal_fingerprintmmiaidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_fingerprintmmiaidl_default)

allow hal_fingerprintmmiaidl_default hal_fingerprintmmiaidl_default_exec:file { read getattr map execute open entrypoint };
allow hal_fingerprintmmiaidl_default system_server_202604:binder { call transfer };
allow hal_fingerprintmmiaidl_default system_server_202604:fd use;
allow hal_fingerprintmmiaidl_default servicemanager_202604:binder { call transfer };
allow hal_fingerprintmmiaidl_default madev_fp_device:chr_file { ioctl read write open };
allow hal_fingerprintmmiaidl_default goodixfingerprintd_device:chr_file { ioctl read write open };
allow hal_fingerprintmmiaidl_default sysfs_202604:file { ioctl read write open };
