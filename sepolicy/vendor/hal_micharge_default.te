# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_micharge_default, domain;
hal_server_domain(hal_micharge_default, hal_micharge)

type hal_micharge_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_micharge_default)

allow hal_micharge_default hal_micharge_default_exec:file { read getattr map execute open entrypoint };
allow hal_micharge_default servicemanager_202604:binder { call transfer };
allow hal_micharge_default system_server_202604:binder call;
allow hal_micharge_default sysfs_202604:dir { read getattr open search };
allow hal_micharge_default sysfs_202604:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_micharge_default sysfs_battery_supply:file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default sysfs_battery_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default sysfs_battery_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_micharge_default sysfs_usb_supply:file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default sysfs_usb_supply:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default sysfs_usb_supply:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default sysfs_batteryinfo_202604:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_micharge_default sysfs_batteryinfo_202604:file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default sysfs_batteryinfo_202604:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_micharge_default sysfs_batteryinfo_202604:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default sysfs_power_202604:dir { open search };
allow hal_micharge_default sysfs_power_202604:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_micharge_default sysfs_ship_mode:file { ioctl read write getattr lock append map open watch watch_reads };
