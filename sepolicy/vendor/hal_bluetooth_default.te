# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_bluetooth_default bt_device_202604:chr_file { ioctl read write open };
allow hal_bluetooth_default self:bluetooth_socket { read write create bind };
allow hal_bluetooth_default hal_bluetooth_default_exec:file { read getattr map execute open entrypoint };
allow hal_bluetooth_default sysfs_202604:file { ioctl read write open };
allow hal_bluetooth_default prod_file:dir search;
allow hal_bluetooth_default mnt_vendor_file_202604:dir search;
allow hal_bluetooth_default prod_file:file { ioctl read write getattr setattr lock append map open watch watch_reads };
allow hal_bluetooth_default serial_device_202604:chr_file { ioctl read write open };
allow hal_bluetooth_default tty_device_202604:chr_file { ioctl read write open };
allow hal_bluetooth_default vendor_data_file_202604:dir { read write create getattr open add_name remove_name search };
allow hal_bluetooth_default vendor_data_file_202604:file { read write create getattr setattr unlink rename open };
allow hal_bluetooth_default port_202604:tcp_socket name_connect;
allow hal_bluetooth_default self:tcp_socket { read write create connect getopt setopt shutdown name_connect };
allow hal_bluetooth_default vendor_sys_prop:file { read getattr map open };
allow hal_bluetooth_default sysfs_bluetooth_file:file { read write open };
allow hal_bluetooth_default coredump_file_202604:dir { read write getattr open add_name remove_name search };
allow hal_bluetooth_default coredump_file_202604:file { read write create getattr setattr unlink open };
allow hal_bluetooth_default ssmh_info_proc:file { read write open };
allow hal_bluetooth_default proc_202604:file { read open };
allow hal_bluetooth_default vendor_fs_prop:file { read getattr map open };
