# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_ir_default hal_ir_default_exec:file { read getattr map execute open entrypoint };
allow hal_ir_default tmpfs_202604:file { read write open };
allow hal_ir_default ir_device:chr_file { ioctl read write open };
allowxperm hal_ir_default ir_device:chr_file ioctl { 0x6913 };
