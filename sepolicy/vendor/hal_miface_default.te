#
# Stock vendor and odm policy, generated by tools/emit.py.
# Review before shipping, the platform side is assumed.
#
type hal_miface_default, domain;
init_daemon_domain(hal_miface_default)
type hal_miface_default_exec, exec_type, file_type, vendor_file_type;
allow hal_miface_default hal_miface_default_exec:file { read getattr map execute open entrypoint };
allow hal_miface_default servicemanager:binder { call transfer };
allow hal_miface_default hwservicemanager:binder { call transfer };
allow hal_miface_default face_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_miface_default face_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_miface_default tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_miface_default camera_config_prop:file { read getattr map open };
allow hal_miface_default cameraserver:binder { call transfer };
allow hal_miface_default cameraserver:fd use;
allow hal_miface_default fwk_camera_hwservice:hwservice_manager find;
allow hal_miface_default hal_graphics_allocator_default:binder { call transfer };
allow hal_miface_default hal_graphics_allocator_default:fd use;
allow hal_miface_default hal_graphics_allocator_default_tmpfs:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_miface_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_miface_default hidl_token_hwservice:hwservice_manager find;
allow hal_miface_default fwk_sensor_hwservice:hwservice_manager find;
allow hal_miface_default property_socket:sock_file write;
allow hal_miface_default init:unix_stream_socket connectto;
allow hal_miface_default vendor_secure_camera_prop:property_service set;
allow hal_miface_default vendor_secure_camera_prop:file { read getattr map open };
