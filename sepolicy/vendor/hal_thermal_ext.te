# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_thermal_ext, domain;
hal_server_domain(hal_thermal_ext, hal_thermal)

type hal_thermal_ext_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_thermal_ext)

allow hal_thermal_ext hal_thermal_ext_exec:file { read getattr map execute open entrypoint };
allow hal_thermal_ext thermald:unix_stream_socket connectto;
allow hal_thermal_ext sysfs_202604:dir { read open };
allow hal_thermal_ext sysfs_202604:file { read getattr open };
allow hal_thermal_ext sysfs_power_202604:file { read getattr open };
allow hal_thermal_ext proc_stat_202604:file { read getattr open };
allow hal_thermal_ext hal_thermal_ext:netlink_kobject_uevent_socket { read write create bind getopt setopt };
