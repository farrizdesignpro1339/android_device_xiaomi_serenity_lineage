# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_mtdservice_default, domain;
hal_server_domain(hal_mtdservice_default, hal_mtdservice)

type hal_mtdservice_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_mtdservice_default)

allow hal_mtdservice_default property_socket_202604:sock_file write;
allow hal_mtdservice_default init_202604:unix_stream_socket connectto;
allow hal_mtdservice_default vendor_security_rpmb_sync_prop:property_service set;
allow hal_mtdservice_default vendor_security_rpmb_sync_prop:file { read getattr map open };
allow hal_mtdservice_default hal_mtdservice_default_exec:file { read getattr map execute open entrypoint };
allow hal_mtdservice_default servicemanager_202604:binder { call transfer };
allow hal_mtdservice_default hal_keymaster:memfd_file { read write getattr map };
allow hal_mtdservice_default tee_202604:unix_stream_socket connectto;
allow hal_mtdservice_default teetz_device:chr_file { ioctl read write open };
allow hal_mtdservice_default prod_file:dir search;
allow hal_mtdservice_default mnt_vendor_file_202604:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_mtdservice_default mnt_vendor_file_202604:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow hal_mtdservice_default tee_device_202604:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_mtdservice_default persist_data_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_mtdservice_default persist_data_file:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow hal_mtdservice_default ion_device_202604:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_mtdservice_default ta_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_mtdservice_default ta_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_mtdservice_default vendor_persist_drm_file:dir { ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_mtdservice_default vendor_persist_drm_file:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow hal_mtdservice_default mnt_vendor_file_202604:dir { ioctl read write create getattr setattr lock relabelfrom rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_mtdservice_default mediadrm_vendor_data_file:dir { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow hal_mtdservice_default mediadrm_vendor_data_file:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow hal_mtdservice_default widevine_drv_device:chr_file { ioctl read write getattr open };
allow hal_mtdservice_default vendor_payment_security_prop:property_service set;
allow hal_mtdservice_default vendor_payment_security_prop:file { read getattr map open };
allow hal_mtdservice_default ctl_stop_prop_202604:property_service set;
allow hal_mtdservice_default ctl_start_prop_202604:property_service set;
allow hal_mtdservice_default dmabuf_system_heap_device_202604:chr_file { ioctl read open };
allow hal_mtdservice_default vendor_cpuid_prop:file { read getattr map open };
allow hal_mtdservice_default vendor_chipid_prop:file { read getattr map open };
allow hal_mtdservice_default vendor_deviceid_prop:file { read getattr map open };
allow hal_mtdservice_default hal_keymint:memfd_file { read write getattr map };
allow hal_mtdservice_default hal_secure_element:memfd_file { read write getattr map };
allow hal_mtdservice_default vendor_initprop_prop:file { read getattr map open };
allow hal_mtdservice_default platform_app_202604:binder transfer;
