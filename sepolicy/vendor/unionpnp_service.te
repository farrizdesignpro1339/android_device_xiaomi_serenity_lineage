# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type unionpnp_service, domain;
typeattribute unionpnp_service mlstrustedsubject;

type unionpnp_service_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(unionpnp_service)

allow unionpnp_service servicemanager_202604:binder { call transfer };
allow unionpnp_service hal_unionpnp_service:service_manager add;
allow unionpnp_service unionpnp_service:capability { sys_admin sys_nice };
allow unionpnp_service kernel_202604:process { getsched setsched };
allow unionpnp_service platform_app_202604:process setsched;
allow unionpnp_service priv_app_202604:process setsched;
allow unionpnp_service system_app_202604:process setsched;
allow unionpnp_service untrusted_app_all:process { getsched setsched };
allow unionpnp_service sysfs_gpu_boost:file { write open };
allow unionpnp_service proc_sprd_dmc:file { read getattr open };
allow unionpnp_service sysfs_ddr_dfs:dir search;
allow unionpnp_service sysfs_ddr_dfs:file { read getattr open };
allow unionpnp_service userlog_device_202604:chr_file { write open };
allow unionpnp_service univiewdv:unix_stream_socket connectto;
allow unionpnp_service vendor_uniview_prop:file { read getattr map open };
allow unionpnp_service vendor_data_file_202604:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow unionpnp_service vendor_data_file_202604:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow unionpnp_service proc_202604:dir search;
allow unionpnp_service proc_202604:file { read write getattr open watch watch_reads };
allow unionpnp_service proc_cpu_usage_202604:file { read write getattr open watch watch_reads };
allow unionpnp_service sysfs_202604:dir { read open search };
allow unionpnp_service sysfs_202604:file { read write getattr open watch watch_reads };
allow unionpnp_service system_server_202604:binder { call transfer };
allow unionpnp_service sysfs_devices_system_cpu_202604:file { write open };
allow unionpnp_service cgroup_202604:file { read write getattr open };
allow unionpnp_service cgroup_202604:dir { read getattr open search };
allow unionpnp_service proc_meminfo_202604:file { read getattr open };
allow unionpnp_service configfs_202604:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow unionpnp_service configfs_202604:file { read write getattr open };
allow unionpnp_service unipnp_prop_202604:file { read getattr map open };
allow unionpnp_service unionpnp_service_exec:file { read getattr map execute open entrypoint };
