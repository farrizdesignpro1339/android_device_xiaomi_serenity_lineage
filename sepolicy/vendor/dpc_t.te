# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type dpc_t, domain;

type dpc_t_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(dpc_t)

allow dpc_t dpc_t_exec:file { read getattr map execute open entrypoint };
allow dpc_t dpc_t_exec:file { read getattr map execute open };
allow dpc_t vendor_sys_prop:file { read getattr map open };
allow dpc_t block_device_202604:dir { read write open search };
allow dpc_t mmcblk_device:blk_file { read write open };
