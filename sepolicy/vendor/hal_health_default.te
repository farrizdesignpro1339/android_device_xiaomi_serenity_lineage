# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_health_default hal_health_default_exec:file { read getattr map execute open entrypoint };
allow hal_health_default sysfs_power_202604:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_health_default sysfs_power_202604:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_health_default hal_health_hwservice_202604:hwservice_manager find;
allow hal_health_default kmsg_device_202604:chr_file getattr;
allow hal_health_default hal_health_default:capability2 wake_alarm;
allow hal_health_default sysfs_202604:file { read getattr open };
allow hal_health_default hal_power_default:binder transfer;
allow hal_health_default hal_power_default:binder { call transfer };
allow hal_health_default hal_power_default:fd use;
