# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type create_spl_link, domain;

type create_spl_link_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(create_spl_link)

allow create_spl_link create_spl_link_exec:file { read getattr map execute open entrypoint };
allow create_spl_link vendor_toolbox_exec_202604:file execute_no_trans;
allow create_spl_link sysfs_202604:dir { read open };
allow create_spl_link sysfs_202604:file getattr;
allow create_spl_link sysfs_wakeup_202604:dir { read open search };
allow create_spl_link sysfs_wakeup_202604:file getattr;
allow create_spl_link block_device_202604:dir { write add_name search };
allow create_spl_link block_device_202604:lnk_file create;
allow create_spl_link rootfs_202604:dir read;
allow create_spl_link proc_sysrq_202604:file { write open };
allow create_spl_link sysfs_dpu_202604:file getattr;
allow create_spl_link mmcblk_device:blk_file getattr;
dontaudit create_spl_link sysfs_type:file getattr;
dontaudit create_spl_link sysfs_gpu_202604:dir { read open };
