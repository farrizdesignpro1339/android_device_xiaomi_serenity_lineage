#
# Stock vendor and odm policy, generated by tools/emit.py.
# Review before shipping, the platform side is assumed.
#
type hal_combined_default, domain;
init_daemon_domain(hal_combined_default)
type hal_combined_default_exec, exec_type, file_type, vendor_file_type;
allow hal_combined_default rebootescrow_hal_prop:file { read getattr map open };
allow hal_combined_default hal_extthermal_hwservice:hwservice_manager { add find };
allow hal_combined_default thermald:unix_stream_socket connectto;
allow hal_combined_default sysfs:dir { read open };
allow hal_combined_default sysfs:file { read write getattr open };
allow hal_combined_default proc_stat:file { read getattr open };
allow hal_combined_default sysfs_lcd:file { read write open };
allow hal_combined_default input_device:chr_file { ioctl read write open };
allow hal_combined_default input_device:dir { read open search };
allow hal_combined_default sysfs_ddr_dfs:file { read write getattr open };
allow hal_combined_default sysfs_ddr_dfs:dir { read getattr open search };
allow hal_combined_default debugfs_ion:dir { read open search };
allow hal_combined_default rebootescrow_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_combined_default rebootescrow_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_combined_default block_device:dir search;
allow hal_combined_default hal_connmgr_hwservice:hwservice_manager { add find };
allow hal_combined_default wcnd:unix_stream_socket { read write getattr sendto connectto };
allow hal_combined_default property_socket:sock_file write;
allow hal_combined_default init:unix_stream_socket connectto;
allow hal_combined_default vendor_display_prop:property_service set;
allow hal_combined_default sysfs_power:file { read write getattr open };
allow hal_combined_default sysfs_power:dir { read getattr open search };
allow hal_combined_default proc:file { read getattr open };
allow hal_combined_default hal_combined_default_exec:file { read getattr map execute open entrypoint };
allow hal_combined_default teetz_device:chr_file { ioctl read write open };
