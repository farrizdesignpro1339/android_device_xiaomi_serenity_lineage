# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_combined_default, domain;
hal_server_domain(hal_combined_default, hal_vibrator)

type hal_combined_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_combined_default)

allow hal_combined_default hal_combined_default_exec:file { read getattr map execute open entrypoint };
allow hal_combined_default rebootescrow_hal_prop_202604:file { read getattr map open };
allow hal_combined_default thermald:unix_stream_socket connectto;
allow hal_combined_default sysfs_202604:dir { read open };
allow hal_combined_default sysfs_202604:file { read write getattr open };
allow hal_combined_default proc_stat_202604:file { read getattr open };
allow hal_combined_default sysfs_lcd:file { read write open };
allow hal_combined_default input_device_202604:chr_file { ioctl read write open };
allow hal_combined_default input_device_202604:dir { read open search };
allow hal_combined_default sysfs_ddr_dfs:file { read write getattr open };
allow hal_combined_default sysfs_ddr_dfs:dir { read getattr open search };
allow hal_combined_default debugfs_ion:dir { read open search };
allow hal_combined_default rebootescrow_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_combined_default rebootescrow_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_combined_default block_device_202604:dir search;
allow hal_combined_default hal_connmgraidl_service:service_manager { add find };
allow hal_combined_default wcnd:unix_stream_socket { read write getattr sendto connectto };
allow hal_combined_default teetz_device:chr_file { ioctl read write open };
allow hal_combined_default property_socket_202604:sock_file { read write };
allow hal_combined_default vendor_display_prop:file { read getattr map open };
allow hal_combined_default property_socket_202604:sock_file write;
allow hal_combined_default init_202604:unix_stream_socket connectto;
allow hal_combined_default vendor_display_prop:property_service set;
allow hal_combined_default sysfs_power_202604:file { read write getattr open };
allow hal_combined_default sysfs_power_202604:dir { read getattr open search };
