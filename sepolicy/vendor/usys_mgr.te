# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type usys_mgr, domain;
typeattribute usys_mgr mlstrustedsubject;

type usys_mgr_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(usys_mgr)

allow usys_mgr usys_mgr_exec:file { read getattr map execute open entrypoint };
allow usys_mgr sysfs_202604:file { read write open };
allow usys_mgr sysfs_202604:dir { read open };
allow usys_mgr sysfs_wake_lock_202604:file { read write open };
allow usys_mgr init_202604:unix_stream_socket connectto;
allow usys_mgr vendor_shell_exec_202604:file { read getattr execute open execute_no_trans };
allow usys_mgr block_device_202604:dir search;
allow usys_mgr mmcblk_device:blk_file { read write open };
allow usys_mgr ufs_device:blk_file { read write open };
allow usys_mgr userdata_block_device_202604:blk_file { read write open };
allow usys_mgr bm_device:chr_file { ioctl read write open };
allow usys_mgr mpu_device:chr_file { ioctl read write getattr open };
allow usys_mgr slog_device:chr_file { read write open };
allow usys_mgr tty_device_202604:chr_file { read write open };
allow usys_mgr proc_sysrq_202604:file { read write create open };
allow usys_mgr cp_diskserver:dir search;
allow usys_mgr cp_diskserver:file { read open };
allow usys_mgr cp_diskserver_v2:dir search;
allow usys_mgr cp_diskserver_v2:file { read open };
allow usys_mgr proc_202604:file { read write setattr open };
allow usys_mgr proc_pmicpmsys:file { read write getattr open };
allow usys_mgr proc_mini_dump:file { read write getattr open };
allow usys_mgr proc_pubcpiram:file { read write getattr open };
allow usys_mgr proc_aoniram:file { read write getattr open };
allow usys_mgr proc_pmicmem:file { read write getattr open };
allow usys_mgr spipe_device:chr_file { read write open };
allow usys_mgr sysfs_spool:file { read open };
allow usys_mgr loader_device:chr_file { ioctl read write open };
allow usys_mgr self:capability2 block_suspend;
allow usys_mgr property_socket_202604:sock_file { read write };
allow usys_mgr powerctl_prop_202604:property_service set;
allow usys_mgr usys_mgr:capability { setgid setuid };
allow usys_mgr proc_cmdline_202604:file { read open };
allow usys_mgr vendor_sys_prop:file { read getattr open };
allow usys_mgr kernel_202604:system module_request;
allow usys_mgr vendor_sys_prop:file { read getattr map open };
allow usys_mgr ctl_start_prop_202604:property_service set;
allow usys_mgr ctl_stop_prop_202604:property_service set;
allow usys_mgr vendor_sys_prop:property_service set;
allow usys_mgr proc_bootconfig_202604:file { read write getattr open };
allow usys_mgr property_socket_202604:sock_file write;
allow usys_mgr vendor_radio_prop:property_service set;
allow usys_mgr vendor_radio_prop:file { read getattr map open };
allow usys_mgr vendor_product_prop:property_service set;
allow usys_mgr vendor_product_prop:file { read getattr map open };
allow usys_mgr vendor_modem_prop:property_service set;
allow usys_mgr vendor_modem_prop:file { read getattr map open };
allow usys_mgr sysfs_nv:file { read write getattr open };
allow usys_mgr device_emmc_powp:chr_file { ioctl read write open };
allow usys_mgr vendor_default_prop_202604:file { read getattr open };
allow usys_mgr teetz_device:chr_file { ioctl read write open };
allow usys_mgr vendor_ch_prop:file { read getattr map open };
allow usys_mgr vendor_sp_prop:file { read getattr map open };
