type dcxsrv, domain;
init_daemon_domain(dcxsrv)
type dcxsrv_exec, exec_type, file_type, vendor_file_type;
allow dcxsrv sysfs:file { ioctl read write open };
allow dcxsrv prod_file:dir { read write open add_name remove_name search };
allow dcxsrv prod_file:file { ioctl read write create getattr setattr lock append map unlink open watch watch_reads };
allow dcxsrv dcxsrv_exec:file { read getattr map execute open entrypoint };
