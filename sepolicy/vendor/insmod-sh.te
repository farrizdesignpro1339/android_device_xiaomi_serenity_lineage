type insmod-sh, domain;
init_daemon_domain(insmod-sh)
type insmod-sh_exec, exec_type, file_type, vendor_file_type;
allow insmod-sh vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow insmod-sh vendor_toolbox_exec:file execute_no_trans;
allow insmod-sh proc_cmdline:file read;
allow insmod-sh self:capability sys_module;
allow insmod-sh system_file:system module_load;
allow insmod-sh kernel:key search;
allow insmod-sh vendor_kernel_modules:system module_load;
allow insmod-sh proc_cmdline:file open;
allow insmod-sh vendor_file:system module_load;
allow insmod-sh proc_cmdline:file getattr;
allow insmod-sh debugfs_bootreceiver_tracing:dir search;
allow insmod-sh debugfs_mm_events_tracing:dir search;
allow insmod-sh self:capability sys_nice;
allow insmod-sh kernel:process setsched;
allow insmod-sh kmsg_device:chr_file { write open };
allow insmod-sh debugfs_ion:dir search;
dontaudit insmod-sh proc_cmdline:file { ioctl read getattr lock map open watch watch_reads };
allow insmod-sh property_socket:sock_file write;
allow insmod-sh init:unix_stream_socket connectto;
allow insmod-sh vendor_device_prop:property_service set;
allow insmod-sh vendor_device_prop:file { read getattr map open };
allow insmod-sh rootfs:dir read;
allow insmod-sh rootfs:dir open;
allow insmod-sh insmod-sh:key write;
allow insmod-sh system_dlkm_file:dir search;
allow insmod-sh system_dlkm_file:dir read;
allow insmod-sh system_dlkm_file:dir getattr;
allow insmod-sh system_dlkm_file:file read;
allow insmod-sh system_dlkm_file:file open;
allow insmod-sh system_dlkm_file:file getattr;
allow insmod-sh system_dlkm_file:system module_load;
allow insmod-sh insmod-sh_exec:file { read getattr map execute open entrypoint };
