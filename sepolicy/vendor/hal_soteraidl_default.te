# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_soteraidl_default, domain;

type hal_soteraidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_soteraidl_default)

allow hal_soteraidl_default hal_soteraidl_default_exec:file { read getattr map execute open entrypoint };
allow hal_soteraidl_default teetz_device:chr_file { ioctl read write open };
allow hal_soteraidl_default system_server_202604:binder { call transfer };
allow hal_soteraidl_default system_server_202604:fd use;
allow hal_soteraidl_default servicemanager_202604:binder { call transfer };
allow hal_soteraidl_default hal_soter_service:service_manager { add find };
