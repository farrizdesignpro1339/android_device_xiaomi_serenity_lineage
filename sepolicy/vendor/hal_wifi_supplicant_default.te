#
# Stock vendor and odm policy, generated by tools/emit.py.
# Review before shipping, the platform side is assumed.
#
type hal_wifi_supplicant_default, domain;
init_daemon_domain(hal_wifi_supplicant_default)
type hal_wifi_supplicant_default_exec, exec_type, file_type, vendor_file_type;
allow hal_wifi_supplicant_default hal_wifi_supplicant_default_exec:file { read getattr map execute open entrypoint };
allow hal_wifi_supplicant_default proc_net_type:file write;
allow hal_wifi_supplicant_default hwservicemanager:binder { call transfer };
allow hal_wifi_supplicant_default system_wifi_keystore_hwservice:hwservice_manager find;
allow hal_wifi_supplicant_default wifi_keystore_service_server:binder { call transfer };
allow hal_wifi_supplicant_default wifi_keystore_service_server:fd use;
allow hal_wifi_supplicant_default wpa_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_wifi_supplicant_default wpa_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_wifi_supplicant_default wpa_data_file:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_wifi_supplicant_default device_logging_prop:file { read getattr map open };
dontaudit hal_wifi_supplicant_default wifi_data_file:dir search;
allow hal_wifi_supplicant_default engpc:unix_dgram_socket sendto;
allow hal_wifi_supplicant_default exported_default_prop:file { read getattr open };
allow hal_wifi_supplicant_default exported_overlay_prop:file { read getattr open };
allow hal_wifi_supplicant_default exported_system_prop:file { read getattr open };
allow hal_wifi_supplicant_default vendor_default_prop:file { read getattr open };
allow hal_wifi_supplicant_default vendor_data_file:dir { read write create getattr open add_name search };
allow hal_wifi_supplicant_default vendor_data_file:file { read write create getattr open };
allow hal_wifi_supplicant_default wifi_hal_prop:file { read getattr map open };
type_transition hal_wifi_supplicant_default wifi_data_file:dir "sockets" wpa_socket;
