# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_refnotifyaidl_default, domain;
typeattribute hal_refnotifyaidl_default mlstrustedobject;

type hal_refnotifyaidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_refnotifyaidl_default)

allow hal_refnotifyaidl_default platform_app_202604:binder transfer;
allow hal_refnotifyaidl_default hal_refnotifyaidl_default_exec:file { read getattr map execute open entrypoint };
allow hal_refnotifyaidl_default servicemanager_202604:binder { call transfer };
allow hal_refnotifyaidl_default hal_refnotifyaidl_service:service_manager { add find };
allow hal_refnotifyaidl_default hwservicemanager_prop_202604:file { read getattr map open };
allow hal_refnotifyaidl_default hwservicemanager_202604:binder { call transfer };
allow hal_refnotifyaidl_default refnotifyHalService:binder { call transfer };
