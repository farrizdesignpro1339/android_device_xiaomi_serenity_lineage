#
# Stock vendor and odm policy, generated by tools/emit.py.
# Review before shipping, the platform side is assumed.
#
type boardid_bin, domain;
init_daemon_domain(boardid_bin)
type boardid_bin_exec, exec_type, file_type, vendor_file_type;
allow boardid_bin boardid_bin_exec:file { read getattr map execute open entrypoint };
allow boardid_bin property_socket:sock_file write;
allow boardid_bin init:unix_stream_socket connectto;
allow boardid_bin vendor_initprop_bin_prop:property_service set;
allow boardid_bin block_device:dir search;
allow boardid_bin property_socket:sock_file write;
allow boardid_bin init:unix_stream_socket connectto;
allow boardid_bin mnt_vendor_file:dir search;
allow boardid_bin metadata_file:dir { write search };
allow boardid_bin metadata_file:file { read write create getattr open };
allow boardid_bin sysfs_dt_firmware_android:dir search;
allow boardid_bin proc_cmdline:file { read open };
allow boardid_bin gsi_metadata_file_type:dir search;
allow boardid_bin metadata_file:dir search;
allow boardid_bin gsi_public_metadata_file:file { ioctl read getattr lock map open watch watch_reads };
allow boardid_bin proc_bootconfig:file { ioctl read getattr lock map open watch watch_reads };
allow boardid_bin proc_cmdline:file { ioctl read getattr lock map open watch watch_reads };
allow boardid_bin version_info:file { ioctl read getattr lock map open watch watch_reads };
