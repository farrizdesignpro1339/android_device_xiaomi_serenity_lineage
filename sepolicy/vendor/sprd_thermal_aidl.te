# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type sprd_thermal_aidl, domain;
hal_server_domain(sprd_thermal_aidl, hal_thermal)

type sprd_thermal_aidl_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(sprd_thermal_aidl)

allow sprd_thermal_aidl sprd_thermal_aidl_exec:file { read getattr map execute open entrypoint };
allow sprd_thermal_aidl sysfs_202604:dir { read open };
allow sprd_thermal_aidl sysfs_202604:file { read getattr open };
allow sprd_thermal_aidl servicemanager_202604:binder { call transfer };
allow sprd_thermal_aidl thermald:unix_stream_socket connectto;
