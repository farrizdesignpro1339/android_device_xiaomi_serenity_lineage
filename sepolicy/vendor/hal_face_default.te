#
# Stock vendor and odm policy, generated by tools/emit.py.
# Review before shipping, the platform side is assumed.
#
type hal_face_default, domain;
init_daemon_domain(hal_face_default)
type hal_face_default_exec, exec_type, file_type, vendor_file_type;
allow hal_face_default hal_face_default_exec:file { read getattr map execute open entrypoint };
allow hal_face_default sysfs:file { read open };
allow hal_face_default vndbinder_device:chr_file { ioctl read write map open };
allow hal_face_default dev_vdsp:chr_file { ioctl read write map open };
allow hal_face_default vndservicemanager:binder call;
allow hal_face_default vdspserver:binder { call transfer };
allow hal_face_default cameraserver:binder { call transfer };
allow hal_face_default exported_camera_prop:file { getattr map open };
allow hal_face_default hidl_token_hwservice:hwservice_manager find;
allow hal_face_default fwk_camera_hwservice:hwservice_manager find;
dontaudit hal_face_default exported_camera_prop:file read;
allow hal_face_default camera_service_server:binder { call transfer };
allow hal_face_default camera_service_server:fd use;
allow hal_face_default camera_service_server:binder transfer;
allow hal_face_default gpu_device:chr_file { ioctl read write map open };
allow hal_face_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_face_default hal_graphics_allocator_default:binder { call transfer };
allow hal_face_default hal_graphics_allocator_default:fd use;
allow hal_face_default hal_graphics_allocator_hwservice:hwservice_manager find;
allow hal_face_default hal_graphics_allocator_default:fd use;
allow hal_face_default fwk_sensor_hwservice:hwservice_manager find;
