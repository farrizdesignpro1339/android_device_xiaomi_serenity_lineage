# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type phasecheckserver, domain;
typeattribute phasecheckserver mlstrustedsubject;

type phasecheckserver_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(phasecheckserver)

allow phasecheckserver phasecheckserver_exec:file { read getattr map execute open entrypoint };
allow phasecheckserver vndbinder_device_202604:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow phasecheckserver vndservicemanager_202604:binder { call transfer };
allow phasecheckserver system_server_202604:binder { call transfer };
allow phasecheckserver system_server_202604:fd use;
allow phasecheckserver phasecheckserver:netlink_kobject_uevent_socket { read create bind setopt };
allow phasecheckserver self:capability net_admin;
allow phasecheckserver prod_file:dir { ioctl read write getattr lock append map open watch watch_reads add_name search };
allow phasecheckserver mnt_vendor_file_202604:dir { ioctl read write getattr lock append map open watch watch_reads add_name search };
allow phasecheckserver prod_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow phasecheckserver sysfs_202604:file { read write open };
allow phasecheckserver block_device_202604:dir search;
allow phasecheckserver tmpfs_202604:dir { write add_name };
allow phasecheckserver mmcblk_device:blk_file { read write getattr open };
allow phasecheckserver userdata_block_device_202604:blk_file { read write getattr open };
allow phasecheckserver phasecheckserver_tmpfs:file create;
allow phasecheckserver sysfs_leds_202604:dir search;
allow phasecheckserver sysfs_leds_202604:file { read write open };
allow phasecheckserver property_socket_202604:sock_file write;
allow phasecheckserver init_202604:unix_stream_socket connectto;
allow phasecheckserver vendor_product_prop:property_service set;
allow phasecheckserver vendor_product_prop:file { read getattr map open };
allow phasecheckserver vendor_product_prop:file { read open };
allow phasecheckserver sysfs_power_202604:dir search;
allow phasecheckserver sysfs_power_202604:file { read write open };
allow phasecheckserver vendor_file_202604:file execute_no_trans;
allow phasecheckserver vendor_shell_exec_202604:file execute_no_trans;
allow phasecheckserver camera_device_202604:chr_file { ioctl read write open };
allow phasecheckserver vendor_toolbox_exec_202604:file execute_no_trans;
allow phasecheckserver prod_file:file create;
allow phasecheckserver proc_202604:file { read write open };
allow phasecheckserver ufs_device:blk_file { read write getattr open };
allow phasecheckserver sysfs_dpu_vendor:file { read open };
allow phasecheckserver sysfs_ddr_dfs:dir search;
allow phasecheckserver sysfs_ddr_dfs:file { read write open };
allow phasecheckserver sysfs_dpu_vsp:file { read open };
allow phasecheckserver sysfs_multipanel_vendor:file { read open };
allow phasecheckserver servicemanager_202604:binder call;
allow phasecheckserver fwk_sensor_service_202604:service_manager find;
allow phasecheckserver sysfs_sensor:file { read write open };
allow phasecheckserver vendor_fs_prop:file { read getattr map open };
