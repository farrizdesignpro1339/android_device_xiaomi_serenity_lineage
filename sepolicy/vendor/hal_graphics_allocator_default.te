#
# Stock vendor and odm policy, generated by tools/emit.py.
# Review before shipping, the platform side is assumed.
#
type hal_graphics_allocator_default, domain;
init_daemon_domain(hal_graphics_allocator_default)
type hal_graphics_allocator_default_exec, exec_type, file_type, vendor_file_type;
allow hal_graphics_allocator_default hal_graphics_allocator_default_exec:file { read getattr map execute open entrypoint };
type_transition hal_graphics_allocator_default tmpfs:file hal_graphics_allocator_default_tmpfs;
allow hal_graphics_allocator_default hal_graphics_allocator_default_tmpfs:file { read write getattr map };
dontaudit hal_graphics_allocator_default unlabeled:dir search;
allow hal_graphics_allocator_default hal_sensors_default:binder transfer;
allow hal_graphics_allocator_default graphics_device:dir search;
allow hal_graphics_allocator_default graphics_device:chr_file { ioctl read write open };
allow hal_graphics_allocator_default vendor_algo_service:binder transfer;
allow hal_graphics_allocator_default vendor_sf_fbc_prop:file { read getattr map open };
allow hal_graphics_allocator_default vendor_gpu_fbc_prop:file { read getattr map open };
allow hal_graphics_allocator_default vendor_vsp_fbc_prop:file { read getattr map open };
allow hal_graphics_allocator_default vendor_whale2_afbc_prop:file { read getattr map open };
allow hal_graphics_allocator_default sensorhub_data_file:dir search;
allow hal_graphics_allocator_default hal_face_default:binder transfer;
allow hal_graphics_allocator_default hal_miface_default:binder transfer;
