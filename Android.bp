soong_namespace {}

install_symlink {
    name: "vendor_lib_modules",
    soc_specific: true,
    installed_location: "lib/modules",
    symlink_target: "/vendor_dlkm/lib/modules",
}

// The toybox [ builtin. Android 17 no longer ships the symlink farm with the
// platform toybox_vendor package, so this one is declared here; extract-utils
// would name the module vendor_bin_[, which Soong rejects
install_symlink {
    name: "vendor_bin_lbracket",
    soc_specific: true,
    installed_location: "bin/[",
    symlink_target: "/vendor/bin/toybox_vendor",
}